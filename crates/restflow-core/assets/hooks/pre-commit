#!/bin/bash
# RestFlow: Prevent task executions from committing on main branch directly.
# This hook is auto-installed by RestFlow daemon on startup.

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

# Only enforce for task execution processes.
if [ -n "$RESTFLOW_AGENT" ] && [ "$BRANCH" = "main" -o "$BRANCH" = "master" ]; then
    echo "ERROR: Task executions must not commit directly to $BRANCH."
    echo "Use a worktree or feature branch instead."
    echo "Task ID: $RESTFLOW_TASK_ID"
    exit 1
fi
